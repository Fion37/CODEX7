# Local development works without cloud services. Private production requires Supabase and owner configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix an AI key with NEXT_PUBLIC_.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Public deployments default to private, even when APP_PRIVATE_MODE is absent.
# Configure the owner's verified Supabase account before deploying.
APP_PRIVATE_MODE=true
APP_OWNER_EMAIL=
# For development or LOCAL-ONLY production validation: APP_PRIVATE_MODE=false
